# Copy to .env.local and fill in. Never commit real values.
# Variables without the NEXT_PUBLIC_ prefix are server-only.
# NEXT_PUBLIC_* values are inlined into the client bundle at build time.
# Each phase adds the variables it needs here.

# Clerk — https://dashboard.clerk.com > your app > API keys
# (or run `clerk env pull` after `clerk auth login`).
# The publishable key also feeds the CSP in next.config.ts, so changing it
# needs a rebuild.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Routes of the embedded sign-in / sign-up pages (app/(auth)/sign-in,
# app/(auth)/sign-up). The (auth) group doesn't appear in the URL.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Where to land after sign-in / sign-up when no redirect_url is given.
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Supabase — https://supabase.com/dashboard > your project > Connect.
# The app uses the publishable key under row-level security; the database
# password is never needed here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
