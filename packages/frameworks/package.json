{
  "name": "@workspace/frameworks",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "description": "Detects each package's framework, and gives files their roles, entry points and routes (docs/specs/002-framework-detection).",
  "exports": {
    ".": "./src/index.ts",
    "./taxonomy": "./src/taxonomy.ts"
  },
  "scripts": {
    "detect": "node src/cli.ts",
    "golden": "node scripts/golden.ts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@workspace/parser": "workspace:*",
    "oxc-parser": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/golden": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "@workspace/vitest-config": "workspace:*",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
