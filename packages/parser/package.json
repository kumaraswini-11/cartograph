{
  "name": "@workspace/parser",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "description": "Parses a directory of JavaScript and TypeScript into files, edges and coverage (docs/specs/001-repository-parser).",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./command": "./src/command.ts",
    "./json": "./src/jsonc.ts",
    "./paths": "./src/paths.ts",
    "./syntax": "./src/syntax.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "parse": "node src/cli.ts",
    "golden": "node scripts/golden.ts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "oxc-parser": "catalog:",
    "oxc-resolver": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/golden": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "@workspace/vitest-config": "workspace:*",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
