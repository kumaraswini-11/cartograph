{
  "name": "@workspace/github",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "description": "Reads public GitHub repositories without a token: what counts as a repository's address, its default branch's commit, and its archive, streamed, filtered and capped.",
  "exports": {
    ".": "./src/index.ts",
    "./address": "./src/address.ts"
  },
  "scripts": {
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "tar": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "@workspace/vitest-config": "workspace:*",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
